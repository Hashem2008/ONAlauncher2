    <string name="app_name">ONA Controls</string>
    <string name="ona_overlay_title">Floating controls (overlay)</string>
    <string name="ona_overlay_open">Floating controls over other apps</string>
    <string name="ona_overlay_open_summary">Winlator-style buttons, sticks and D-pads on top of any app you pick (emulators, games). Shown only when that app is open.</string>
    <string name="ona_overlay_summary">Pick the apps, pick a profile for each, then open the app: the controls appear by themselves and hide when you leave it.</string>
